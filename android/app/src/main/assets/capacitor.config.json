{
	"appId": "com.visitquranonline.imanjourney",
	"appName": "Iman Journey - Islamic History Adventure",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"backgroundColor": "#022c22"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#064e3b",
			"showSpinner": false
		}
	}
}
